// waybar/config.jsonc — minimal, no bloat
// Left: workspaces + window title
// Center: clock
// Right: cpu · temp · ram · net · volume · tray
{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 0,
  "exclusive": true,
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "pulseaudio",
    "tray"
  ],
  // ── Workspaces ──────────────────────────────────
  "hyprland/workspaces": {
    "format": "{id}",
    "sort-by-number": true,
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",
    "all-outputs": false,
    "active-only": false,
  },
  // ── Active window title ─────────────────────────
  "hyprland/window": {
    "format": "{title}",
    "max-length": 60,
    "separate-outputs": true,
    "rewrite": {
      "(.*) — Mozilla Firefox": "  $1",
      "(.*) - Visual Studio Code": "  $1",
      "(.*) - fish": "  $1",
      "(.*) - bash": "  $1",
      "(.*) - zsh": "  $1",
      "(.*)Steam(.*)": "  Steam",
    },
  },
  // ── CPU ─────────────────────────────────────────
  "cpu": {
    "interval": 2,
    "format": "  {usage}%",
    "tooltip": false,
    "states": {
      "warning": 60,
      "critical": 85,
    },
  },
  // ── CPU Temperature ─────────────────────────────
  // If this shows N/A: run `ls /sys/class/hwmon/*/temp*_input`
  // then uncomment and set the path below.
  "temperature": {
    "interval": 5,
    "format": "  {temperatureC}°",
    "format-critical": "  {temperatureC}°",
    "critical-threshold": 85,
    "tooltip": false,
    // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input"
  },
  // ── Memory ──────────────────────────────────────
  "memory": {
    "interval": 5,
    "format": "󰍛  {used:0.1f}G",
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G  ({percentage}%)",
    "states": {
      "warning": 70,
      "critical": 90,
    },
  },
  // ── Network ─────────────────────────────────────
  "network": {
    "interval": 2,
    "format-ethernet": "󰈀  {bandwidthUpBits} ↑  {bandwidthDownBits} ↓",
    "format-wifi": "  {essid}  {bandwidthDownBits} ↓",
    "format-disconnected": "󰤭  offline",
    "tooltip-format": "Interface: {ifname}\nIP: {ipaddr}\nGateway: {gwaddr}",
    "tooltip-format-wifi": "SSID: {essid}\nIP: {ipaddr}\nSignal: {signalStrength}%",
  },
  // ── Volume ──────────────────────────────────────
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰖁  muted",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ],
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "scroll-step": 2,
    "tooltip": false,
  },
  // ── Clock ───────────────────────────────────────
  "clock": {
    "format": "  {:%a %d %b  %H:%M}",
    "tooltip-format": "<big>{:%Y}</big>\n<tt><small>{calendar}</small></tt>",
  },
  // ── System tray ─────────────────────────────────
  "tray": {
    "icon-size": 14,
    "spacing": 8,
  },
}
